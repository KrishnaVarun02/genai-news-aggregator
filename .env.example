DATABASE_URL=postgresql+psycopg://news:local-development-only@localhost:55432/news
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4.1-mini
CURATOR_MODEL=gpt-4o-mini
EMAIL_MODEL=gpt-4o-mini
# Live paid requests require this explicit opt-in; never used by fixture mode.
ALLOW_PAID_API=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=news@example.invalid
SMTP_TO=reader@example.invalid
SMTP_STARTTLS=false
# Real delivery additionally requires --send real and this explicit opt-in.
ALLOW_REAL_EMAIL=false
PROFILE_PATH=config/profile.json
SOURCES_PATH=config/sources.json
PREVIEW_DIR=previews
